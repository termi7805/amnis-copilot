{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amnis Copilot",
  "version": "0.1.2",
  "identifier": "dev.amnis.pet",
  "build": {
    "frontendDist": "../fallback",
    "beforeDevCommand": {
      "script": "pnpm --filter @amnis/web build && pnpm --filter @amnis/daemon build:sea",
      "wait": true
    },
    "beforeBuildCommand": "pnpm --filter @amnis/web build && pnpm --filter @amnis/daemon build:sea"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/amnis-daemon"],
    "resources": {
      "resources/": "resources/"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
